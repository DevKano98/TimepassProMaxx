# --- Database ---
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/civicguard?sslmode=require

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Resend ---
RESEND_API_KEY=re_your_resend_api_key

# --- Firebase Cloud Messaging ---
# Full service-account JSON as a single-line string (or a file path - be consistent).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project", "...":"..."}

# --- Web Push / VAPID ---
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_ADMIN_EMAIL=admin@example.com

# --- Hugging Face Inference API ---
HUGGINGFACE_API_TOKEN=hf_your_token

# --- Groq (LLM ticket generation) ---
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Geocoding / Routing / Weather ---
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
ORS_API_KEY=your-openrouteservice-api-key
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Anonymous reporting rate limit ---
ANON_REPORT_DAILY_LIMIT=3

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Internal service-to-service auth ---
INTERNAL_API_KEY=change-me-to-a-long-random-string

# --- ml-service ---
ML_SERVICE_URL=https://civicguard-ml.onrender.com
ML_SERVICE_TIMEOUT_SECONDS=15

# --- CORS ---
FRONTEND_ORIGIN=https://civicguard-dashboard.example.com
FIELD_APP_ORIGIN=https://civicguard-field.example.com

# --- OTP ---
OTP_EXPIRE_MINUTES=10
OTP_MAX_REQUESTS_PER_HOUR=5

# --- Server ---
PORT=8000
